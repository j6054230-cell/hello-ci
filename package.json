{
  "name": "hello-ci",
  "version": "1.0.0",
  "description": "CI/CD amaliyot loyihasi",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --forceExit --bail",
    "test:watch": "jest --watch"
  },
  "author": "Jamshid",
  "license": "ISC",
  "devDependencies": {
    "jest": "^29.0.0"
  },
  "jest": {
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 50,
        "functions": 80,
        "lines": 80
      }
    }
  }
}
